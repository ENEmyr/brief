{
  "name": "brief",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "e2e"],
  "packageManager": "bun@1.2.19",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "bash e2e/run.sh",
    "format": "prettier --write .",
    "e2e:visual": "bash e2e/visual/run.sh",
    "e2e:visual:refs": "bash e2e/visual/run.sh refs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.10",
    "katex": "^0.18.11",
    "postcss": "^8.5.31",
    "sharp": "^0.35.4",
    "tinypool": "^2.1.2",
    "undici": "^7.29.0",
    "ws": "^8.20.1"
  }
}
